{
  "name": "testfly-mcp",
  "displayName": "TestFly MCP — AI Browser Automation & Codegen",
  "description": "MCP server for TestFly and Selenium WebDriver automation. Lets GitHub Copilot, Claude, and AI assistants control a real browser — 88 tools for navigation, interaction, assertions, and framework-native test codegen.",
  "version": "1.0.0",
  "publisher": "testfly",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Testing",
    "Other"
  ],
  "keywords": [
    "testfly",
    "mcp",
    "selenium",
    "browser automation",
    "testing",
    "copilot",
    "claude",
    "webdriver",
    "testng",
    "junit5",
    "cucumber"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hakanngul/testfly-mcp"
  },
  "homepage": "https://github.com/hakanngul/testfly-mcp",
  "bugs": {
    "url": "https://github.com/hakanngul/testfly-mcp/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testfly-mcp-view",
          "title": "TestFly MCP",
          "icon": "resources/testfly.svg"
        }
      ]
    },
    "views": {
      "testfly-mcp-view": [
        {
          "id": "testfly.quickActions",
          "name": "Quick Actions",
          "type": "tree"
        },
        {
          "id": "testfly.status",
          "name": "Environment & Project Status",
          "type": "tree"
        },
        {
          "id": "testfly.tools",
          "name": "Available MCP Tools (88)",
          "type": "tree"
        }
      ]
    },
    "mcpServers": {
      "testfly": {
        "label": "TestFly MCP",
        "type": "stdio",
        "command": "testfly-mcp"
      }
    },
    "configuration": {
      "title": "TestFly MCP",
      "properties": {
        "testflyMcp.registerProjectMcpJson": {
          "type": "boolean",
          "default": false,
          "description": "Also write a project-level .mcp.json into every open workspace folder, registering the TestFly MCP server for Claude Code. Off by default: the global ~/.claude/settings.json registration already covers every project, and this drops an untracked file into each workspace."
        }
      }
    },
    "commands": [
      {
        "command": "testfly-mcp.menu",
        "title": "TestFly MCP: Open Actions Menu"
      },
      {
        "command": "testfly-mcp.launchStudio",
        "title": "TestFly MCP: Start TestFly Recorder (Playwright-Style)",
        "icon": "$(record)"
      },
      {
        "command": "testfly-mcp.initProject",
        "title": "TestFly MCP: Scaffold New Project (testfly init)",
        "icon": "$(file-code)"
      },
      {
        "command": "testfly-mcp.shardTests",
        "title": "TestFly MCP: Run CI Test Sharder (testfly shard)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "testfly-mcp.checkStatus",
        "title": "TestFly MCP: Check Installation & Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "testfly-mcp.initConfig",
        "title": "TestFly MCP: Initialize testfly.yml Config",
        "icon": "$(gear)"
      },
      {
        "command": "testfly-mcp.install",
        "title": "TestFly MCP: Install Server"
      },
      {
        "command": "testfly-mcp.upgrade",
        "title": "TestFly MCP: Upgrade to Latest"
      },
      {
        "command": "testfly-mcp.refreshStatus",
        "title": "TestFly MCP: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "testfly-mcp.openDocs",
        "title": "TestFly MCP: Open Documentation",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "testfly-mcp.refreshStatus",
          "when": "view == testfly.status",
          "group": "navigation"
        },
        {
          "command": "testfly-mcp.launchStudio",
          "when": "view == testfly.quickActions",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.4.0"
  }
}
