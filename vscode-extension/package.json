{
  "name": "testfly-mcp",
  "displayName": "TestFly MCP — AI Browser Automation & Codegen",
  "description": "MCP server for TestFly and Selenium WebDriver automation. Lets GitHub Copilot, Claude, and AI assistants control a real browser — 88 tools for navigation, interaction, assertions, and framework-native test codegen.",
  "version": "1.0.0",
  "publisher": "testfly",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Testing",
    "Other"
  ],
  "keywords": [
    "testfly",
    "mcp",
    "selenium",
    "browser automation",
    "testing",
    "copilot",
    "claude",
    "webdriver",
    "testng",
    "junit5",
    "cucumber"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seleniumboot/selenium-mcp"
  },
  "homepage": "https://github.com/seleniumboot/selenium-mcp",
  "bugs": {
    "url": "https://github.com/seleniumboot/selenium-mcp/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServers": {
      "testfly": {
        "label": "TestFly MCP",
        "type": "stdio",
        "command": "testfly-mcp"
      }
    },
    "configuration": {
      "title": "TestFly MCP",
      "properties": {
        "testflyMcp.registerProjectMcpJson": {
          "type": "boolean",
          "default": false,
          "description": "Also write a project-level .mcp.json into every open workspace folder, registering the TestFly MCP server for Claude Code. Off by default: the global ~/.claude/settings.json registration already covers every project, and this drops an untracked file into each workspace."
        }
      }
    },
    "commands": [
      {
        "command": "testfly-mcp.install",
        "title": "TestFly MCP: Install (pip install testfly-mcp)"
      },
      {
        "command": "testfly-mcp.upgrade",
        "title": "TestFly MCP: Upgrade to latest"
      },
      {
        "command": "testfly-mcp.checkStatus",
        "title": "TestFly MCP: Check installation status"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.4.0"
  }
}
